+@pytest.mark.parametrize("context", ["", "A similar document. " * 200])
+def test_classification_budgets_document_and_retrieved_context(mock_document, context):
+    from llama_index.core.utils import get_tokenizer
+
+    from paperless_ai.client import LLM_SYSTEM_PROMPT
+    from paperless_ai.indexing import AI_OUTPUT_RESERVE
+
+    mock_document.content = "Invoice details. " * 20000
+    config = SimpleNamespace(llm_context_size=65536, llm_embedding_chunk_size=1024)
+    candidates = TaxonomyCandidates(
+        tags=[TaxonomyCandidate(id=1, name="Invoice", weight=1.0)],
+        correspondents=[],
+        document_types=[],
+        storage_paths=[],
+    )
+
+    prompt = build_prompt_with_rag(mock_document, config, candidates, context)
+
+    assert "Invoice details." in prompt
+    assert "Additional context from similar documents" in prompt
+    assert "Invoice" in prompt
+    if context:
+        assert "A similar document." in prompt
+    input_tokens = len(get_tokenizer()(LLM_SYSTEM_PROMPT + "\n" + prompt))
+    assert input_tokens + AI_OUTPUT_RESERVE <= config.llm_context_size
 
 
