+def test_workflow_client_limits_do_not_change_generic_requests(
+    mock_ai_config,
+    mock_ollama_llm,
+):
+    mock_ai_config.llm_backend = "ollama"
+    mock_ai_config.llm_model = "test_model"
+    mock_ai_config.llm_endpoint = "http://test-url"
+
+    with (
+        patch("ollama.Client") as sync_client,
+        patch("ollama.AsyncClient") as async_client,
+    ):
+        AIClient()
+        workflow_client = AIClient(thinking=True, request_timeout=600)
+        AIClient()
+
+    assert mock_ai_config.llm_request_timeout == 120
+    assert [call.kwargs["thinking"] for call in mock_ollama_llm.call_args_list] == [
+        False,
+        True,
+        False,
+    ]
+    for calls, key in [
+        (mock_ollama_llm.call_args_list, "request_timeout"),
+        (sync_client.call_args_list, "timeout"),
+        (async_client.call_args_list, "timeout"),
+    ]:
+        assert [call.kwargs[key] for call in calls] == [120, 600, 120]
+
+    mock_llm = workflow_client.llm
+    mock_llm.chat.return_value.message.content = '{"title": "Invoice"}'
+    workflow_client.run_llm_query("Invoice document")
+    assert mock_llm.chat.call_args.kwargs["think"] is True
